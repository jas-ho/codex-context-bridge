{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/path/to/codex-context-bridge",
            "timeout": 5,
            "additionalContextLimit": 5000,
            "statusMessage": "Loading Claude context"
          }
        ]
      }
    ]
  }
}
